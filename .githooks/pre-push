set -uo pipefail

failed=0
started=$SECONDS

step() {
  local label="$1"
  shift

  if ! "$@" >/tmp/scribe-tools-prepush.log 2>&1; then
    echo "FAILED   $label"
    sed 's/^/         /' /tmp/scribe-tools-prepush.log | tail -25
    failed=$((failed + 1))
    return
  fi

  echo "ok       $label"
}

missing() {
  echo "skipped  $1 ($2 is not installed)"
}

if command -v dart >/dev/null 2>&1; then
  step "scribe analyzes" bash -c 'cd scribe && dart analyze'
  step "sdk analyzes"    bash -c 'cd sdk && dart analyze'
else
  missing "the Dart checks" dart
fi

if command -v deno >/dev/null 2>&1; then
  step "docs type-checks" bash -c 'cd docs && deno check walk_routes.ts'
else
  missing "the Deno check" deno
fi

step "every source file carries the license header" bash .github/headers/check.sh

rm -f /tmp/scribe-tools-prepush.log

if [ "$failed" -gt 0 ]; then
  cat >&2 <<MESSAGE

Push refused: $failed check(s) failed after $((SECONDS - started))s.

These are the same checks CI runs, so pushing would only move the failure to a
place where it blocks the release instead of your terminal.

If you know what you are doing, git push --no-verify skips this hook. CI will
still catch it, and main will still refuse the merge.
MESSAGE
  exit 1
fi

echo "All checks passed in $((SECONDS - started))s"
