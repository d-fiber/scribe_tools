{
  "name": "Commit message format",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Tagged commit messages",
        "operator": "regex",
        "negate": false,
        "pattern": "^(\\[(DEV|BUGFIX|REFACTO|DOC|TEST|CI|PERF|SECURITY|BREAKING|RELEASE|REVERT|CHORE)\\]: .+|Merge )"
      }
    }
  ]
}
